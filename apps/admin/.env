# 应用标题
VITE_APP_TITLE=Gnilc Auth

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=gnilc-auth-admin

# standard 隔离旧版本的语言偏好和消息键标签页；后续兼容升级复用此命名空间。
VITE_APP_STORAGE_NAMESPACE=gnilc-auth-standard-admin-storage-v1

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=1zVbmfncry2RKh2BzJFL
